{
  "name": "medistock-phoenix",
  "private": true,
  "version": "2.0.0",
  "description": "MediStock-Babil Phoenix V2 — Clean rebuild",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:phoenix": "node scripts/phoenix-assets.mjs",
    "capture:phoenix": "node scripts/phoenix-capture.mjs",
    "ocr:assets": "node scripts/ocr-assets.mjs",
    "prebuild": "node scripts/ocr-assets.mjs",
    "ocr:fixtures": "node tools/ocr-eval/generate-fixtures.mjs",
    "ocr:eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.2.10",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.45.0",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "5.0.8"
      }
    }
  }
}
