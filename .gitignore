# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/

# Env — NEVER commit
.env
.env.local
.env.*.local
*.env

# Backups — NEVER commit
backups/
*.sql.gz
*.dump

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Vitest
coverage/

.vercel

# OCR runtime assets — reproducible via scripts/ocr-assets.mjs (pinned SHA-256)
public/assets/ocr/

# OCR evaluation fixtures — regenerate with `npm run ocr:fixtures`
tools/ocr-eval/fixtures/

# tesseract.js writes langPath cache copies beside the cwd when run in Node
/ara.traineddata
/eng.traineddata
/*.traineddata

# TLS trust material: the pinned .sha256 IS committed, the certificate is not.
ops/certs/*.crt
ops/certs/*.pem
ops/certs/*.key

# Release evidence: generated locally by the R0 release engine, never
# committed (real hashes of a real machine's real rehearsal). The schema
# documentation stays committed.
ops/evidence/*.json
ops/evidence/*.log
ops/evidence/*.dump
!ops/evidence/README.md

# Filled-in target manifests: real staging/clone project refs and hosts,
# never committed. The .example.json templates and production.json (which
# carries no environment-specific secret, only a fixed public project ref)
# stay committed.
ops/targets/staging.json
ops/targets/rehearsal-clone.json
