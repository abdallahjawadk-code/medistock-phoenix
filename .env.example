# MediStock Phoenix V2 — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local

PHOENIX_SUPABASE_PROJECT_REF=eyrzxgfkvqybjdgyphap
PHOENIX_SUPABASE_URL=https://eyrzxgfkvqybjdgyphap.supabase.co
PHOENIX_SUPABASE_ANON_KEY=your-anon-key-here
PHOENIX_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Frontend (Vite exposes only VITE_* vars to the browser)
VITE_PHOENIX_SUPABASE_URL=https://eyrzxgfkvqybjdgyphap.supabase.co
VITE_PHOENIX_SUPABASE_ANON_KEY=your-anon-key-here

# ── Batch identity (migration 051) ──────────────────────────────────────────
# Build-time gate for the 7-column material identity introduced by migration
# 051 (distribution_point_id + scientific_name + concentration + dosage_form
# + national_code + batch_number + expiry_date). It MUST agree with the DB
# the app points at:
#
#   true   → the target DB HAS migration 051 applied. The editor matches the
#            same 7 fields the DB's unique index and phoenix_upsert_availability
#            already enforce, so different batches/expiries stay separate rows
#            and quantity edits target one exact batch.
#   false  → the target DB does NOT have 051 applied (legacy 4-field matching).
#
# Migration 051 IS applied to the Supabase project referenced above, so any
# environment pointing at it should set this to true. Leaving it unset/false
# against a post-051 DB makes the editor match on 4 fields while the DB
# matches on 7 — the editor can then mislabel a new batch as an edit of an
# existing one.
#
# This is inlined by Vite at BUILD time (import.meta.env), not read at
# runtime: changing it on Vercel requires a fresh build/redeploy to take
# effect. Anything other than the exact string 'true' is treated as false.
VITE_PHOENIX_BATCH_IDENTITY_051_ENABLED=true

# ── Scoped RBAC mode (migration 062) ────────────────────────────────────────
# PHOENIX_SCOPED_RBAC_MODE — controls the scoped-RBAC authorization layer
# (src/shared/authz). Three values, and only these three:
#
#   off                  → the scoped engine never runs. Authorization is
#                          exactly what it is today (migration 010's effective
#                          permissions). Zero new RPC traffic.
#   shadow               → the scoped engine runs ALONGSIDE the current one on
#                          read-only surfaces. Both answers are compared and
#                          mismatches are reported (dev/test console only).
#                          The CURRENT answer still decides everything — nobody
#                          is blocked because migration 062 disagreed.
#   enforce_super_admin  → the super_admin pilot. Users with role super_admin
#                          are gated by the scoped engine for routes, menus and
#                          read-only actions. EVERY other role stays shadow-only.
#                          Database RLS remains the final authority regardless.
#
# There is deliberately NO value that enforces for all roles. Full enforcement
# is a later, separate phase.
#
# DEFAULTS when unset: 'shadow' in dev/test, 'off' in production. An
# unrecognized value falls back to that default — a typo can never enable
# enforcement.
#
# Inlined by Vite at BUILD time, like the flag above: changing it on Vercel
# requires a fresh build/redeploy.
#
# ── CURRENT STATE (do not conflate these) ──────────────────────────────────
# These six are distinct, and "shadow mode is on" is not a statement about any
# one of them. See docs/rbac-staging-activation.md for the full table.
#
#   code merged               → YES. The layer exists in master.
#   dev/test default          → YES. Unset here resolves to 'shadow'.
#   staging shadow activation → NO.  Requires this var set in the staging build.
#   production                → OFF. Unset in production resolves to 'off'.
#   super-admin pilot         → NO.  Implemented; not enabled in any environment.
#   broad enforcement         → NO.  No such value exists.
#
# A deployed environment is in shadow mode ONLY if its build was produced with
# VITE_PHOENIX_SCOPED_RBAC_MODE=shadow actually present. Confirm it from the
# startup diagnostic's `explicitlyConfigured: true` — never by assuming.
#
# The value below applies to a LOCAL .env.local copy, where 'shadow' is also
# the default. It says nothing about what any deployed environment runs.
VITE_PHOENIX_SCOPED_RBAC_MODE=shadow
